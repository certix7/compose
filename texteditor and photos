class MainActivity : ComponentActivity() {
  override fun onCreate(savedInstanceState: Bundle?) {
    super.onCreate(savedInstanceState)
    enableEdgeToEdge()

    setContent {
      // Pro Way: Wrap everything inside the auto-padding architecture wrapper
      Myapp {
        // Calling both composables inside the main container
//        GetText()
//        Dobutton()
//        Dotext()
        DoImage()
      }
    }
  }
}

@Composable
fun Myapp(content: @Composable () -> Unit) {
  Card(
    modifier = Modifier
      .fillMaxSize()
      .systemBarsPadding() // Enforces auto padding against Status and Navigation bars
      .padding(16.dp),     // Application outer margin
    colors = CardDefaults.cardColors(containerColor = Color.Gray)
  ) {
    content() // Inject and execute child composables dynamically
  }
}

@Composable
fun GetText() {
  Text(
    modifier = Modifier.padding(top = 25.dp, start = 10.dp),
    text = "this is textxxxxxxxxxx",
    style = TextStyle(
      color = Color.White,
      fontSize = 25.sp,
      fontStyle = FontStyle.Italic,
      background = Color.Gray,
      textAlign = TextAlign.Center
    )
  )
}

@Composable
fun Dobutton() {
  // State toggles between true and false
  var active by remember { mutableStateOf(true) }

  Button(
    enabled = true,
    onClick = {
      active = !active
    }
  ) {
    Text(
      text = if (active) "start new world" else "return to world",
    )
  }
}


@Composable
fun Dotext() {
  var email by remember { mutableStateOf("4555") }

  TextField(
    value = email,
    onValueChange = {
      email = it
    }, label = {Text("input your email")}, modifier = Modifier.padding(top=10.dp)
  )
}


@Composable
fun DoImage(){

